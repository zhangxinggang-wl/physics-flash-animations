# ------------------------------------------------------------
# 排除 Windows 可执行文件
#   - 浏览器无法运行 .exe，在线完全用不上
#   - 113 个 exe 占 295 MB，是整个资源库体积的 74.5%
#   - 上传它们会让仓库从 101 MB 膨胀到 396 MB
# ------------------------------------------------------------
*.exe
*.EXE

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 编辑器 / 系统杂项
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 本地备份
*.bak
*~

# 临时文件
*.tmp
*tmp*.html
